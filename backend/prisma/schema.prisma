// Data model for the Salary Management Tool. Requirement IDs refer to docs/PRD.md.
//
// SQLite has no enums in Prisma, so enum-like columns are Strings. Their allowed values
// live in src/domain/constants.ts and are enforced by validation before anything is saved.
// Money is stored as Decimal (never Float) so rounding is exact (PRD §5.7, NFR-03).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "sqlite"
}

/// A supported country. Each country has exactly one currency (A3, A4, FR-CUR-01).
model Country {
  code         String @id // ISO 3166-1 alpha-2, e.g. "US"
  name         String @unique
  currencyCode String // ISO 4217, e.g. "USD"
  locale       String // BCP 47 locale the UI uses to format amounts, e.g. "en-US"

  structures SalaryStructure[]
  employees  Employee[]
}

/// A predefined, country-specific salary template (FR-STR-01). Fixed amounts are in the country's currency.
model SalaryStructure {
  id                   Int     @id @default(autoincrement())
  name                 String  @unique
  style                String // STANDARD | SALES | HOURLY
  countryCode          String
  variableTargetPct    Decimal // % of monthly base, e.g. 10 for 10%
  standardMonthlyHours Int
  overtimeMultiplier   Decimal // e.g. 1.5

  country    Country              @relation(fields: [countryCode], references: [code])
  components StructureComponent[]
  employees  Employee[]

  @@index([countryCode])
}

/// One earning or deduction line of a salary structure.
model StructureComponent {
  id          Int     @id @default(autoincrement())
  structureId Int
  kind        String // EARNING | DEDUCTION
  name        String
  basis       String // PCT_BASE | PCT_GROSS (deductions only) | FIXED
  value       Decimal // a percentage for PCT_*, an amount in the country's currency for FIXED
  sortOrder   Int

  structure SalaryStructure @relation(fields: [structureId], references: [id], onDelete: Cascade)

  @@unique([structureId, name])
}

/// An employee record (FR-EMP-01..06). Currency is not stored here: it always comes from the country.
model Employee {
  id               Int      @id @default(autoincrement())
  employeeCode     String   @unique // system-assigned, also the login ID (A10)
  fullName         String
  jobTitle         String
  countryCode      String
  annualBaseSalary Decimal
  structureId      Int
  status           String   @default("ACTIVE") // ACTIVE | INACTIVE
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  country       Country         @relation(fields: [countryCode], references: [code])
  structure     SalaryStructure @relation(fields: [structureId], references: [id])
  account       Account?
  payrollInputs PayrollInput[]
  payslips      Payslip[]

  @@index([countryCode, status])
  @@index([fullName])
  @@index([jobTitle])
}

/// Login credentials, kept apart from employee data so a password hash is never loaded with an employee.
/// HR accounts have no employee; employee accounts are linked 1:1 (FR-AUTH-01, NFR-06).
model Account {
  id                 Int      @id @default(autoincrement())
  loginId            String   @unique
  passwordHash       String
  role               String // HR | EMPLOYEE
  mustChangePassword Boolean  @default(true) // FR-AUTH-04
  employeeId         Int?     @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  employee Employee? @relation(fields: [employeeId], references: [id])
  sessions Session[]
}

/// A logged-in session. Deleting it logs the user out; it expires after inactivity (FR-AUTH-03).
model Session {
  id             String   @id @default(uuid())
  accountId      Int
  createdAt      DateTime @default(now())
  lastActivityAt DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

/// One payroll run per calendar month (A7, FR-PAY-04). Status only moves forward:
/// DRAFT → FINALISED → DISBURSED (FR-PAY-06).
model PayrollRun {
  id           Int       @id @default(autoincrement())
  month        String    @unique // "YYYY-MM"
  status       String    @default("DRAFT") // DRAFT | FINALISED | DISBURSED
  calculatedAt DateTime?
  finalisedAt  DateTime?
  disbursedAt  DateTime?
  paymentDate  DateTime? // the date HR records as the payment date
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  inputs   PayrollInput[]
  payslips Payslip[]
}

/// One employee's variable inputs for a month (FR-PAY-01). No row means the defaults apply:
/// 0 overtime hours, 0 bonus, 100% variable pay achievement.
model PayrollInput {
  id             Int     @id @default(autoincrement())
  runId          Int
  employeeId     Int
  overtimeHours  Decimal @default(0)
  bonus          Decimal @default(0) // in the employee's currency
  achievementPct Decimal @default(100)

  run      PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  employee Employee   @relation(fields: [employeeId], references: [id])

  @@unique([runId, employeeId])
}

/// One employee's pay for one run. Every value shown on the payslip is copied here when it is
/// issued, so later changes to the employee never alter it (FR-PAY-05).
model Payslip {
  id               Int      @id @default(autoincrement())
  runId            Int
  employeeId       Int
  employeeCode     String
  fullName         String
  jobTitle         String
  countryCode      String
  countryName      String
  currency         String
  structureName    String
  annualBaseSalary Decimal
  overtimeHours    Decimal
  bonus            Decimal
  achievementPct   Decimal
  gross            Decimal
  totalDeductions  Decimal
  net              Decimal
  flagged          Boolean // deductions exceed gross pay; blocks finalising (FR-PAY-02)
  createdAt        DateTime @default(now())

  run      PayrollRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  employee Employee      @relation(fields: [employeeId], references: [id])
  lines    PayslipLine[]

  @@unique([runId, employeeId])
  @@index([employeeId])
  @@index([runId, countryCode])
}

/// One earning or deduction line of a payslip, as calculated (PRD §5.7).
model PayslipLine {
  id          Int     @id @default(autoincrement())
  payslipId   Int
  kind        String // BASE | EARNING | VARIABLE | OVERTIME | BONUS | DEDUCTION
  label       String
  calculation String
  amount      Decimal
  sortOrder   Int

  payslip Payslip @relation(fields: [payslipId], references: [id], onDelete: Cascade)

  @@index([payslipId])
}
