NODE_ENV=development
PORT=4000
# error | warn | info | http | debug | silent
LOG_LEVEL=info
# SQLite file, relative to the backend folder
DATABASE_URL=file:./dev.db
# Required in production (min 32 chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Log out after this many minutes without activity (FR-AUTH-03)
SESSION_IDLE_MINUTES=30
# bcrypt cost factor for password hashing
BCRYPT_ROUNDS=10
# Max login attempts per IP per 15 minutes
LOGIN_RATE_LIMIT=20
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173
